# Automation platform deployment lockdown (plan §4.4 and §6.1).
# Copy these values into the deployment environment. Do not commit real secrets.

# Public registration: n8n has no public sign-up route. Users join by
# invitation only, and invitations need the user:create scope. No setting is
# needed.

# End-user community-node installation is off. The install path rejects
# requests when this is false.
N8N_COMMUNITY_PACKAGES_ENABLED=false
